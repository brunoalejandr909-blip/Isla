name: Build APK
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - name: Ordenar archivos
        run: |
          mkdir -p app/src/main/java/com/example/isla app/src/main/assets
          mv AndroidManifest.xml app/src/main/
          mv MainActivity.kt IslandService.kt app/src/main/java/com/example/isla/
          mv island.html app/src/main/assets/
          mv app.build.gradle.kts app/build.gradle.kts
      - run: gradle assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: isla-apk
          path: app/build/outputs/apk/debug/*.apk
